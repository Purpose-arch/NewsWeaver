# Telegram API credentials
API_ID=123456
API_HASH=abcdef1234567890abcdef1234567890
STRING_SESSION=1BJWap...long_string...AxcqH

# Bot token from @BotFather
BOT_TOKEN=12345:AABBCCDDEEFFGG

# Source channels to monitor (comma-separated IDs)
SOURCE_IDS=-1001234567890,-1009876543210

# Target channel for published content
TARGET_ID=-1001112223334

# Channel for alert messages monitoring (rocket/UAV alerts)
SOURCE_CHANNEL_ID=air_alert_channel
# Target uses the same TARGET_ID as the main bot

# Admin user IDs for moderation (comma-separated)
ADMIN_IDS=123456789,987654321

# Google AI API keys (comma-separated)
GOOGLE_AI_API_KEYS=AIzaAABCC...longkey,AIzaDDEFF...longkey

# AI models to use in priority order (comma-separated)
AI_MODELS=gemini-1.5-pro-exp-03-25,gemini-1.5-pro,gemini-1.5-flash

# Requesty.io API keys (comma-separated)
REQUESTY_APIS=req_abcdef1234567890,req_qwertyuiop09876

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bot_database
DB_USER=postgres
DB_PASSWORD=your_password
# Alternatively, use DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:port/database

# Moderation chat ID
MODERATION_CHAT_ID=-1001234509876 